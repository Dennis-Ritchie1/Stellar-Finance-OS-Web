VITE_API_URL=http://localhost:3000/v1
VITE_STELLAR_NETWORK=testnet          # must match backend
VITE_EXPLORER_URL=https://stellar.expert/explorer/testnet
VITE_PAY_APP_URL=http://localhost:5174
VITE_ENABLE_MOCKS=true                # dev only: serve the API from MSW mocks until the backend is up
VITE_HORIZON_URL=https://horizon-testnet.stellar.org   # used by the pay app to build & submit client payments
VITE_SENTRY_DSN=                      # optional: enables crash reporting (scrubbed); unset = nothing is sent
