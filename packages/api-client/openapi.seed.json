{
  "openapi": "3.1.0",
  "info": {
    "title": "Finance OS API (bootstrap seed)",
    "version": "0.0.0",
    "description": "Placeholder spec used only until finance-os-backend publishes /openapi.json. Replace by running `pnpm api:generate` against the real backend."
  },
  "paths": {
    "/invoices": {
      "get": {
        "operationId": "listInvoices",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/InvoiceStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invoices for the current org",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Invoice"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/invoices/{publicToken}": {
      "get": {
        "operationId": "getPublicInvoice",
        "parameters": [
          {
            "name": "publicToken",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public view of an invoice for the pay page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicInvoice"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account and organization created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No content"
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/clients": {
      "get": {
        "operationId": "listClients",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Client"
                      }
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createClient",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/clients/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getClient",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateClient",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InvoiceStatus": {
        "type": "string",
        "enum": ["draft", "sent", "partially_paid", "paid", "overdue", "void"]
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/InvoiceStatus"
          },
          "clientId": {
            "type": "string"
          },
          "clientName": {
            "type": "string"
          },
          "amount": {
            "type": "string",
            "description": "Decimal string, never a float"
          },
          "amountPaid": {
            "type": "string",
            "description": "Decimal string, never a float"
          },
          "assetCode": {
            "type": "string"
          },
          "issueDate": {
            "type": "string",
            "format": "date-time"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "publicToken": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "status",
          "clientId",
          "clientName",
          "amount",
          "amountPaid",
          "assetCode",
          "issueDate",
          "dueDate",
          "publicToken",
          "notes"
        ]
      },
      "PublicInvoice": {
        "type": "object",
        "properties": {
          "businessName": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/InvoiceStatus"
          },
          "amount": {
            "type": "string",
            "description": "Decimal string, never a float"
          },
          "amountPaid": {
            "type": "string",
            "description": "Decimal string, never a float"
          },
          "assetCode": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "lineItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineItem"
            }
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentReference"
          }
        },
        "required": [
          "businessName",
          "number",
          "status",
          "amount",
          "amountPaid",
          "assetCode",
          "dueDate",
          "lineItems",
          "payment"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["code", "message"]
      },
      "Role": {
        "type": "string",
        "enum": ["owner", "admin", "approver", "accountant", "viewer"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "email", "name"]
      },
      "Membership": {
        "type": "object",
        "properties": {
          "orgId": {
            "type": "string"
          },
          "orgName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": ["orgId", "orgName", "role"]
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          }
        },
        "required": ["user", "memberships"]
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          }
        },
        "required": ["token", "user", "memberships"]
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["email", "password"]
      },
      "RegisterInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "orgName": {
            "type": "string"
          }
        },
        "required": ["name", "email", "password", "orgName"]
      },
      "Client": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "senderAddresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "name", "email", "senderAddresses", "createdAt"]
      },
      "ClientInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "senderAddresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["name", "email"]
      },
      "MemoType": {
        "type": "string",
        "enum": ["text", "id", "hash"]
      },
      "LineItem": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "string",
            "description": "Decimal string, never a float"
          },
          "unitPrice": {
            "type": "string",
            "description": "Decimal string, never a float"
          },
          "total": {
            "type": "string",
            "description": "Decimal string, never a float"
          }
        },
        "required": ["description", "quantity", "unitPrice", "total"]
      },
      "LineItemInput": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "string",
            "description": "Decimal string, never a float"
          },
          "unitPrice": {
            "type": "string",
            "description": "Decimal string, never a float"
          }
        },
        "required": ["description", "quantity", "unitPrice"]
      },
      "PaymentReference": {
        "type": "object",
        "properties": {
          "muxedAddress": {
            "type": "string",
            "description": "M-address unique to this invoice"
          },
          "address": {
            "type": "string",
            "description": "Treasury G-address"
          },
          "memo": {
            "type": "string",
            "description": "Required when paying the G-address"
          },
          "memoType": {
            "$ref": "#/components/schemas/MemoType"
          },
          "assetIssuer": {
            "type": "string"
          }
        },
        "required": ["muxedAddress", "address", "memo", "memoType", "assetIssuer"]
      },
      "InvoiceMatch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "transactionId": {
            "type": "string"
          },
          "txHash": {
            "type": "string"
          },
          "amount": {
            "type": "string",
            "description": "Decimal string, never a float"
          },
          "assetCode": {
            "type": "string"
          },
          "matchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "method": {
            "type": "string",
            "enum": ["automatic", "manual"]
          },
          "from": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "transactionId",
          "txHash",
          "amount",
          "assetCode",
          "matchedAt",
          "method",
          "from"
        ]
      },
      "InvoiceDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Invoice"
          },
          {
            "type": "object",
            "properties": {
              "lineItems": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/LineItem"
                }
              },
              "payment": {
                "$ref": "#/components/schemas/PaymentReference"
              },
              "matches": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/InvoiceMatch"
                }
              }
            },
            "required": ["lineItems", "payment", "matches"]
          }
        ]
      },
      "InvoiceInput": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string"
          },
          "assetCode": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          },
          "lineItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineItemInput"
            }
          }
        },
        "required": ["clientId", "assetCode", "dueDate", "lineItems"]
      }
    }
  }
}
